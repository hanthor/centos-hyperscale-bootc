[baseos-source]
name=CentOS Stream - BaseOS - Source
baseurl=https://composes.stream.centos.org/stream-10/production/CentOS-Stream-10-20250427.0/compose/BaseOS/source/tree/
gpgcheck=1
repo_gpgcheck=0
enabled=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-centosofficial-SHA256 # Check access

[appstream-source]
name=CentOS Stream - AppStream - Source
baseurl=https://composes.stream.centos.org/stream-10/production/CentOS-Stream-10-20250427.0/compose/AppStream/source/tree/
gpgcheck=1
repo_gpgcheck=0
enabled=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-centosofficial-SHA256 # Check access

[epel-source]
name=Extra Packages for Enterprise Linux 10 - Source
# metalink=https://mirrors.fedoraproject.org/metalink?repo=epel-source-10&arch=source
baseurl=http://mirror.freedif.org/fedora/epel/10.1/Everything/source/tree
gpgkey=https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-10
gpgcheck=1
repo_gpgcheck=0
enabled=1

[centos-hyperscale-source]
name=CentOS Stream 10 - Hyperscale - Source
# metalink=https://mirrors.centos.org/metalink?repo=centos-hyperscale-sig-packages-main-source-10-stream&arch=source&protocol=https,http
baseurl=http://mirror.freedif.org/CentOS/SIGs/10-stream/hyperscale/source/packages-main/
enabled=1
gpgkey=https://www.centos.org/keys/RPM-GPG-KEY-CentOS-SIG-HyperScale

[centos-hyperscale-kernel-source]
name=CentOS Stream 10 - Hyperscale Kernel - Source
# metalink=https://mirrors.centos.org/metalink?repo=centos-hyperscale-sig-packages-kernel-source-10-stream&arch=source&protocol=https,http
baseurl=http://mirror.freedif.org/CentOS/SIGs/10-stream/hyperscale/source/packages-kernel/
gpgcheck=1
enabled=1
gpgkey=https://www.centos.org/keys/RPM-GPG-KEY-CentOS-SIG-HyperScale